<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Checking GitHub for a newer release and downloading it. Only ever talks to github.com
         (and the storage GitHub serves release files from), and only while update checks are on
         or the user asks. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Handing the downloaded update to Android's installer. The app updates itself, so with
         UPDATE_PACKAGES_WITHOUT_USER_ACTION Android installs it without its own confirmation
         (the user already said yes on the Nine update screen); otherwise Android asks once to
         allow it ("Install unknown apps") and to confirm each update. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- Reading the look chosen in the phone's first-time setup (SetupChoices): Android only
         lets an app see another app's provider when it says so here. -->
    <queries>
        <provider android:authorities="io.github.ninetailsflip.setup.choices" />
    </queries>

    <application>
        <activity
            android:name="io.github.ninetailsflip.update.UpdateActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:theme="@style/Theme.Nine" />
    </application>
</manifest>
