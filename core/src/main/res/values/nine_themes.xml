<resources>
    <style name="Theme.Nine" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Matches the app's own black background + white/dim-gray text convention, instead of the
         default Material dark dialog's gray card and teal accent. Used for every AlertDialog. -->
    <style name="Theme.Nine.Dialog" parent="@android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackgroundFloating">@android:color/black</item>
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="android:textColorSecondary">#FF8A8A8A</item>
        <item name="android:colorAccent">@android:color/white</item>
    </style>

    <!-- Overrides the default style every plain TextView picks up (via the theme's
         android:textViewStyle attribute), so the optional monospace setting applies to every
         screen's text — including views rebuilt later (e.g. calendar rows) — without touching
         each TextView individually. -->
    <style name="NineTextViewStyle.Monospace" parent="@android:style/Widget.TextView">
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="Theme.Nine.Monospace" parent="Theme.Nine">
        <item name="android:textViewStyle">@style/NineTextViewStyle.Monospace</item>
    </style>

    <style name="Theme.Nine.Dialog.Monospace" parent="Theme.Nine.Dialog">
        <item name="android:textViewStyle">@style/NineTextViewStyle.Monospace</item>
    </style>
</resources>
